DEEPSEEK_API_KEY=sk-replace-me
GEMINI_API_KEY=replace-me-or-leave-blank-to-disable-photo-input
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
GEMINI_MODEL_VISION=gemini-3.5-flash-lite
RENDER_TIMEOUT_S=300
RENDER_MAX_REPAIRS=2
FAKE_LLM=0

# Narration. Leave FISH_API_KEY blank to render silent videos. Note that
# fish.audio bills API credit separately from platform credit -- a key with
# website credit but no API credit returns HTTP 402.
FISH_API_KEY=replace-me-or-leave-blank-for-silent-videos
FISH_MODEL=s2.1-pro-free
# A voice id from fish.audio. MUST be set: each beat is a separate request, so an
# unset voice gives a six-beat video six different narrators. Find ids with the
# /model endpoint; calibrate the rate with scripts/measure_voice.py.
FISH_VOICE_ID=ba1cd26ca87b42b2bf7d60c1f65f9242
NARRATION_ENABLED=1
